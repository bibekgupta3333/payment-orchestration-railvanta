# Copy to .env and export explicitly; the binary does not auto-load env files.
APP_ENV=sandbox
HTTP_ADDR=127.0.0.1:8080
HEALTH_ADDR=127.0.0.1:8081
SQLITE_PATH=data/railvanta.db
PUBLIC_APP_ORIGIN=http://localhost:3000
DEMO_MODE=false
# For loopback-only seeded fixtures, enable demo mode and supply fresh secrets.
# DEMO_OPERATOR_KEY=operator.<random-secret>
# DEMO_READER_KEY=reader.<random-secret>
# DEMO_OTHER_WORKSPACE_KEY=other.<random-secret>
# DEMO_SESSION_TOKEN=<random-secret>
# DEMO_CSRF_TOKEN=<random-secret>
