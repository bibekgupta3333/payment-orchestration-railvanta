# Docker Compose settings. Placeholders and safe defaults only: never commit a
# real .env, and never put API keys, session tokens or provider credentials here.
# Compose reads these from the environment or an untracked .env file.

# Host port for the same-origin proxy (published on 127.0.0.1 only).
RAILVANTA_PORT=3000

# Release label recorded in backup manifests and the image environment.
RAILVANTA_RELEASE=dev
RAILVANTA_GIT_SHA=

# Optional: local image tags, and the data volume. scripts/restore-backup.sh
# prints the RAILVANTA_DATA_VOLUME to use after restoring into a new volume.
# RAILVANTA_API_IMAGE=railvanta-api:local
# RAILVANTA_WEB_IMAGE=railvanta-web:local
# RAILVANTA_DATA_VOLUME=railvanta_railvanta-data

# Sandbox credentials are never baked into images. Provision them into a fresh
# sandbox volume with `railvanta-api seed-demo`, passing DEMO_OPERATOR_KEY,
# DEMO_READER_KEY and DEMO_OTHER_WORKSPACE_KEY (prefix.random, at least 24
# characters of freshly generated randomness) in that command's environment.
